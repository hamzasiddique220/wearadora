{
  "name": "wearadora",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first next dev",
    "build": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first next build",
    "start": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first next start",
    "lint": "next lint",
    "convert:images": "python3 scripts/convert-images-webp.py",
    "backup:firestore": "tsx scripts/backup-firestore.ts",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-wearadora \"tsx --test tests/rules/*.test.ts\""
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "lucide-react": "^0.453.0",
    "marked": "^18.0.5",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "firebase-tools": "^13.35.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
